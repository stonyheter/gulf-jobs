# ==============================================================================
# GULF JOBS PLATFORM (وظائف الخليج) - PHASE 6.1 ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# Only client-safe public variables are exposed to the browser.
# ==============================================================================

# Supabase Public Client Credentials (Safe for browser with Row Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Application URL and Environment
VITE_APP_URL=http://localhost:3000
VITE_APP_ENV=development

# Storage Bucket (Private CVs)
VITE_STORAGE_BUCKET=private-cvs
VITE_MAX_CV_FILE_SIZE_MB=5
